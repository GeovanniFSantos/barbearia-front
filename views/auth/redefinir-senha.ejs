<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Nova Senha</title>
    <link rel="shortcut icon" type="imagex/png" href="./img/LogoPrincipal_Trasparente.png"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' }
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in { animation: fadeIn 0.5s ease-out forwards; }
    </style>
    </style>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-88775JZJQS"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-88775JZJQS');
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 flex items-center justify-center min-h-screen p-4 transition-colors duration-300">

    <div class="bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl w-full max-w-md animate-fade-in border border-gray-100 dark:border-gray-700">
        
        <div class="text-center mb-8">
            <% if (typeof barbearia !== 'undefined' && barbearia && barbearia.foto_perfil) { %>
                <img src="<%= barbearia.foto_perfil %>" alt="Logo <%= barbearia.nome %>" class="w-20 h-20 mx-auto rounded-full object-cover border-4 border-gray-100 shadow-md mb-4">
                <h2 class="text-2xl font-black text-gray-800 dark:text-white">Criar Nova Senha</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= barbearia.nome %></p>
            <% } else { %>
                <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-sm">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h2 class="text-2xl font-black text-gray-800 dark:text-white">Criar Nova Senha</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Sua conta foi validada. Defina a nova senha.</p>
            <% } %>
        </div>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="bg-red-50 text-red-600 p-3 rounded-xl mb-6 text-sm font-bold border border-red-200 text-center"><i class="fa-solid fa-triangle-exclamation"></i> <%= erro %></div>
        <% } %>

        <form action="/barbearia-app/auth/redefinir-senha" method="POST" class="space-y-5" onsubmit="return validarSenhas()">
            <input type="hidden" name="token" value="<%= token %>">
            <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
            
            <div>
                <label class="block text-xs uppercase font-bold text-gray-500 tracking-wider mb-2">Nova Senha</label>
                <div class="relative">
                    <input type="password" id="senha_nova" name="password" required class="w-full p-3.5 pr-12 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition-all font-medium">
                    <button type="button" onclick="toggleEye('senha_nova', 'eye_nova')" class="absolute right-4 top-4 text-gray-400 hover:text-gray-600">
                        <i class="fa-solid fa-eye" id="eye_nova"></i>
                    </button>
                </div>
            </div>
            
            <div>
                <label class="block text-xs uppercase font-bold text-gray-500 tracking-wider mb-2">Confirmar Senha</label>
                <div class="relative">
                    <input type="password" id="senha_confirma" required class="w-full p-3.5 pr-12 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition-all font-medium">
                    <button type="button" onclick="toggleEye('senha_confirma', 'eye_confirma')" class="absolute right-4 top-4 text-gray-400 hover:text-gray-600">
                        <i class="fa-solid fa-eye" id="eye_confirma"></i>
                    </button>
                </div>
                <p id="erroMsg" class="text-red-500 text-xs font-bold mt-2 hidden">As senhas não coincidem!</p>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white p-3.5 rounded-xl font-bold transition-all shadow-md mt-4">
                Salvar e Entrar
            </button>
        </form>
    </div>

    <script>
        function toggleEye(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        function validarSenhas() {
            const s1 = document.getElementById('senha_nova').value;
            const s2 = document.getElementById('senha_confirma').value;
            if (s1 !== s2) {
                document.getElementById('erroMsg').classList.remove('hidden');
                return false;
            }
            return true;
        }
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <script src="/barbearia-app/public/js/theme.js"></script>
</body>
</html>