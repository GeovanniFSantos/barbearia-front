<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Sua Conta</title>
    <link rel="shortcut icon" type="imagex/png" href="../public/img/LogoPrincipal_Trasparente.png"/>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' }
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeIn 0.5s ease-out forwards; }
    </style>
    </style>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-88775JZJQS"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-88775JZJQS');
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 flex items-center justify-center min-h-screen p-4 transition-colors duration-300">

    <div class="bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl w-full max-w-md animate-fade-in border border-gray-100 dark:border-gray-700">
        
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-sm">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="text-2xl font-black text-gray-800 dark:text-white">Crie sua Conta</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Cadastre-se para gerenciar seus agendamentos</p>
        </div>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 p-3 rounded-xl mb-6 text-sm text-center font-bold flex items-center justify-center gap-2">
                <i class="fa-solid fa-circle-exclamation"></i> <%= erro %>
            </div>
        <% } %>

        <form action="/barbearia-app/auth/cadastro" method="POST" class="space-y-5">
            <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
            
            <div>
                <label class="block text-xs uppercase font-bold text-gray-500 tracking-wider mb-2">Nome Completo</label>
                <input type="text" name="nome" required class="w-full p-3.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition-all font-medium">
            </div>
            
            <div>
                <label class="block text-xs uppercase font-bold text-gray-500 tracking-wider mb-2">E-mail</label>
                <input type="email" name="email" required class="w-full p-3.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition-all font-medium">
            </div>
            
            <div>
                <label class="block text-xs uppercase font-bold text-gray-500 tracking-wider mb-2">Telefone / WhatsApp</label>
                <input type="text" name="telefone" placeholder="(75) 99999-9999" class="w-full p-3.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition-all font-medium">
            </div>
            
            <div>
                <label class="block text-xs uppercase font-bold text-gray-500 tracking-wider mb-2">Senha</label>
                <input type="password" name="password" required class="w-full p-3.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition-all font-medium">
            </div>

            <div class="flex items-start pt-2">
                <div class="flex items-center h-5 mt-0.5">
                    <input id="termos" name="termos" type="checkbox" required class="w-5 h-5 border border-gray-300 rounded-md bg-gray-50 focus:ring-3 focus:ring-blue-300 dark:bg-gray-900 dark:border-gray-600 dark:focus:ring-blue-600 dark:ring-offset-gray-800 cursor-pointer accent-blue-600">
                </div>
                <label for="termos" class="ml-3 text-sm font-medium text-gray-600 dark:text-gray-400 cursor-pointer leading-tight">
                    Eu li e concordo com os <a href="/barbearia-app/termos" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline font-bold">Termos de Uso</a> e a <a href="/barbearia-app/privacidade" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline font-bold">Política de Privacidade</a>.
                </label>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white p-3.5 rounded-xl font-bold transition-all shadow-md hover:shadow-lg flex justify-center items-center gap-2 mt-2">
                <i class="fa-solid fa-user-check"></i> Finalizar Cadastro
            </button>

            <div class="mt-6">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-3 bg-white dark:bg-gray-800 text-gray-400 font-bold uppercase tracking-wider text-[10px]">Ou continue com</span>
                    </div>
                </div>

                <div class="mt-6">
                    <a href="/barbearia-app/auth/google=<%= typeof redirect !== 'undefined' ? redirect : '' %>" class="w-full flex items-center justify-center px-4 py-3.5 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm bg-gray-50 dark:bg-gray-900/50 text-sm font-bold text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <svg class="h-5 w-5 mr-3" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                        Entrar com o Google
                    </a>
                </div>
            </div>
        </form>

        <div class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">
            Já possui uma conta? <a href="/barbearia-app/auth/login=<%= typeof redirect !== 'undefined' ? redirect : '' %>" class="text-blue-600 dark:text-blue-400 font-bold hover:underline">Faça login</a>
        </div>
    </div>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <script src="/barbearia-app/public/js/theme.js"></script>
</body>
</html>