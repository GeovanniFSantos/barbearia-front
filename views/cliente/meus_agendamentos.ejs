<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meus Agendamentos</title>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' };
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
    </style>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-88775JZJQS"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-88775JZJQS');
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 transition-colors duration-300 antialiased min-h-screen flex flex-col">

    <%- include('../partials/navbar_cliente') %>

    <main class="flex-grow max-w-5xl mx-auto px-4 py-10 w-full animate-slide-up">
        
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl p-8 md:p-10 text-white shadow-lg shadow-blue-500/20 mb-10 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white opacity-10 blur-3xl"></div>
            <div class="absolute bottom-0 right-32 -mb-12 w-40 h-40 rounded-full bg-blue-400 opacity-20 blur-2xl"></div>
            
            <div class="relative z-10">
                <h2 class="text-3xl md:text-4xl font-black mb-2 tracking-tight">Olá, <%= nomeCliente.split(' ')[0] %>! 👋</h2>
                <p class="text-blue-100 text-base md:text-lg font-medium max-w-lg">Acompanhe aqui o seu histórico de estilo, confirme os seus horários e veja os serviços concluídos.</p>
            </div>
        </div>

        <% if (agendamentos.length === 0) { %>
            <div class="text-center py-20 px-4 bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-dashed border-gray-200 dark:border-gray-700 animate-slide-up" style="animation-delay: 0.1s;">
                <div class="w-24 h-24 bg-gray-50 dark:bg-gray-900 rounded-full flex items-center justify-center mx-auto mb-6 text-5xl text-gray-300 dark:text-gray-600 shadow-inner">
                    <i class="fa-regular fa-calendar-xmark"></i>
                </div>
                <h3 class="text-2xl font-black text-gray-800 dark:text-white mb-2">A sua agenda está vazia</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-sm mx-auto">Você ainda não marcou nenhum horário pelo nosso sistema. Que tal agendar um corte agora mesmo?</p>
                
                <a href="/" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-black py-3.5 px-8 rounded-xl shadow-lg transition-transform hover:scale-105">
                    <i class="fa-solid fa-scissors mr-2"></i> Agendar um Serviço
                </a>
            </div>
        <% } else { %>
            <div class="grid gap-6 lg:grid-cols-2">
                <% agendamentos.forEach((a, index) => { 
                    // Extração inteligente de datas
                    const dataObj = new Date(a.data_hora);
                    const dia = String(dataObj.getDate()).padStart(2, '0');
                    const mes = dataObj.toLocaleDateString('pt-BR', { month: 'short' }).replace('.', '').toUpperCase();
                    const diaSemana = dataObj.toLocaleDateString('pt-BR', { weekday: 'long' });
                    const horaFormatada = dataObj.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                    
                    // Configuração de Cores por Status
                    let corStatus = { bg: 'bg-gray-100', text: 'text-gray-600', dot: 'bg-gray-500', label: 'Desconhecido' };
                    if (a.status === 'agendado') corStatus = { bg: 'bg-amber-50 dark:bg-amber-900/20', text: 'text-amber-700 dark:text-amber-500', border: 'border-amber-200 dark:border-amber-800', dot: 'bg-amber-500', label: 'Aguardando' };
                    else if (a.status === 'aceito') corStatus = { bg: 'bg-blue-50 dark:bg-blue-900/20', text: 'text-blue-700 dark:text-blue-400', border: 'border-blue-200 dark:border-blue-800', dot: 'bg-blue-500', label: 'Confirmado' };
                    else if (a.status === 'concluido') corStatus = { bg: 'bg-green-50 dark:bg-green-900/20', text: 'text-green-700 dark:text-green-400', border: 'border-green-200 dark:border-green-800', dot: 'bg-green-500', label: 'Concluído' };
                    else corStatus = { bg: 'bg-red-50 dark:bg-red-900/20', text: 'text-red-700 dark:text-red-400', border: 'border-red-200 dark:border-red-800', dot: 'bg-red-500', label: 'Cancelado' };
                %>
                    <div class="flex flex-col sm:flex-row bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group animate-slide-up" <%- `style="animation-delay: ${index * 0.1}s;"` %>>                        
                        <div class="bg-gray-50 dark:bg-gray-800/50 sm:w-32 p-6 flex sm:flex-col items-center justify-between sm:justify-center border-b sm:border-b-0 sm:border-r border-gray-100 dark:border-gray-700 relative overflow-hidden">
                            <div class="absolute top-0 left-0 right-0 h-1 <%= corStatus.dot %>"></div>
                            
                            <div class="text-center">
                                <span class="block text-gray-400 dark:text-gray-500 text-[10px] font-black uppercase tracking-widest mb-1"><%= diaSemana.split('-')[0] %></span>
                                <span class="block text-4xl font-black text-gray-800 dark:text-white leading-none"><%= dia %></span>
                                <span class="block text-blue-600 dark:text-blue-400 text-sm font-black uppercase tracking-wider mt-1"><%= mes %></span>
                            </div>
                            <div class="sm:mt-4 px-3 py-1.5 bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700">
                                <span class="text-gray-800 dark:text-white text-sm font-black"><i class="fa-regular fa-clock text-gray-400 mr-1"></i><%= horaFormatada %></span>
                            </div>
                        </div>

                        <div class="p-6 flex-grow flex flex-col justify-between">
                            
                            <div>
                                <div class="flex justify-between items-start mb-2">
                                    <h4 class="font-black text-xl text-gray-800 dark:text-white leading-tight pr-2"><%= a.servico_nome %></h4>
                                    <span class="flex-shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider <%= corStatus.bg %> <%= corStatus.text %> border <%= corStatus.border %>">
                                        <span class="w-1.5 h-1.5 rounded-full <%= corStatus.dot %> mr-1.5 animate-pulse"></span>
                                        <%= corStatus.label %>
                                    </span>
                                </div>
                                
                                <p class="text-sm font-bold text-gray-500 dark:text-gray-400 flex items-center gap-1.5 mb-4">
                                    <i class="fa-solid fa-location-dot text-gray-300"></i> <%= a.barbearia_nome %>
                                </p>
                                
                                <div class="space-y-2 mb-6 bg-gray-50 dark:bg-gray-900/50 p-3 rounded-xl border border-gray-100 dark:border-gray-700">
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-gray-500 font-medium">Profissional:</span>
                                        <span class="font-bold text-gray-800 dark:text-gray-200"><%= a.profissional_nome %></span>
                                    </div>
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-gray-500 font-medium">Valor:</span>
                                        <span class="font-black text-green-600 dark:text-green-400">R$ <%= Number(a.valor_total).toFixed(2) %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex gap-2 mt-auto">
                                <a href="/barbearia-app/" class="flex-1 text-center text-xs font-bold bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 py-2.5 rounded-xl transition-colors shadow-sm">
                                    Ver Salão
                                </a>
                                
                                <% if (a.barbearia_telefone && (a.status === 'agendado' || a.status === 'aceito')) { %>
                                    <a href="https://wa.me/55<%= a.barbearia_telefone.replace(/\D/g, '') %>" target="_blank" class="flex-1 flex items-center justify-center gap-1.5 text-xs font-bold bg-green-50 dark:bg-green-900/20 hover:bg-green-100 dark:hover:bg-green-900/40 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800 py-2.5 rounded-xl transition-colors shadow-sm">
                                        <i class="fa-brands fa-whatsapp text-sm"></i> Mensagem
                                    </a>
                                <% } %>
                            </div>
                            
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

<script src="/barbearia-app/public/js/theme.js"></script>
</body>
</html>