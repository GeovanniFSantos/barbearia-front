<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serviços do Catálogo - Gestão</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' };
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
        .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; }
    </style>
</head>
<body class="bg-gray-50 dark:bg-[#0f141e] text-gray-800 dark:text-gray-100 transition-colors duration-300 font-sans">

    <%- include('../partials/sidebar') %>

        <main class="p-4 md:p-8 max-w-7xl mx-auto w-full">
            
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-5 animate-slide-up" <%- `style="animation-delay: 0s;"` %>>
                <div>
                    <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50 shadow-sm">
                            <i class="fa-solid fa-tags text-xl"></i>
                        </div>
                        Catálogo de Serviços
                    </h2>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-2 ml-[3.25rem]">Gerencie os procedimentos, durações e valores oferecidos.</p>
                </div>
                
                <button onclick="toggleModal('modalServico')" class="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-blue-500/20 transition-all hover:scale-[1.02] flex items-center justify-center whitespace-nowrap">
                    <i class="fa-solid fa-plus mr-2"></i> Adicionar Serviço
                </button>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700/60 overflow-hidden animate-slide-up" <%- `style="animation-delay: 0.1s;"` %>>
                <div class="overflow-x-auto custom-scrollbar pb-2">
                    <table class="w-full text-left min-w-[800px]">
                        <thead class="bg-gray-50/50 dark:bg-gray-700/30 border-b-2 border-gray-100 dark:border-gray-700/50">
                            <tr>
                                <th class="py-5 px-6 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Procedimento</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 w-1/3">Descrição</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Tempo Médio</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Valor Final</th>
                                <th class="py-5 px-6 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 dark:divide-gray-700/30">
                            <% if (servicos.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="py-16 text-center">
                                        <div class="w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-300 dark:text-gray-600 text-2xl">
                                            <i class="fa-solid fa-box-open"></i>
                                        </div>
                                        <p class="text-gray-400 font-bold">O catálogo está vazio. Adicione seu primeiro serviço!</p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% servicos.forEach(s => { %>
                                    <tr class="hover:bg-gray-50/80 dark:hover:bg-gray-700/20 transition-colors group">
                                        <td class="py-4 px-6">
                                            <div class="flex items-center gap-3">
                                                <div class="w-2 h-2 rounded-full bg-blue-500 group-hover:scale-150 transition-transform"></div>
                                                <span class="font-black text-gray-900 dark:text-white text-base"><%= s.nome %></span>
                                            </div>
                                        </td>
                                        
                                        <td class="py-4 px-4">
                                            <p class="text-sm font-medium text-gray-500 dark:text-gray-400 line-clamp-2 pr-4 leading-relaxed" title="<%= s.descricao %>">
                                                <%= s.descricao || 'Sem descrição detalhada.' %>
                                            </p>
                                        </td>
                                        
                                        <td class="py-4 px-4 text-center">
                                            <span class="inline-flex items-center gap-1.5 text-[11px] font-black text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700/50 px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-600">
                                                <i class="fa-regular fa-clock text-blue-500"></i> <%= s.duracao_minutos %> MIN
                                            </span>
                                        </td>
                                        
                                        <td class="py-4 px-4">
                                                <span class="inline-block whitespace-nowrap text-base md:text-lg font-black text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 px-3 py-1.5 rounded-lg border border-emerald-100 dark:border-emerald-500/20 shadow-sm">
                                                R$ <%= Number(s.preco).toFixed(2) %>
                                            </span>
                                        </td>
                                        
                                        <td class="py-4 px-6 text-center">
                                            <div class="flex justify-center gap-2">
                                                <button onclick="abrirModalEditarServico('<%= s.id %>', '<%= s.nome %>', '<%= s.descricao %>', '<%= s.preco %>', '<%= s.duracao_minutos %>')" 
                                                        class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-400 hover:bg-blue-500 hover:border-blue-500 hover:text-white flex items-center justify-center transition-all hover:scale-110 shadow-sm hover:shadow-blue-500/30" title="Editar Serviço">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button onclick="abrirModalExcluirServico('<%= s.id %>', '<%= s.nome %>')" 
                                                        class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-400 hover:bg-red-500 hover:border-red-500 hover:text-white flex items-center justify-center transition-all hover:scale-110 shadow-sm hover:shadow-red-500/30" title="Excluir Serviço">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<div id="modalServico" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden border border-gray-100 dark:border-gray-700">
        
        <div class="bg-gradient-to-br from-blue-600 to-indigo-800 p-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-32 h-32 bg-white opacity-10 rounded-full blur-2xl"></div>
            <button onclick="toggleModal('modalServico')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-2xl font-black tracking-tight"><i class="fa-solid fa-layer-group mr-2"></i>Novo Serviço</h3>
            <p class="text-blue-100 text-sm mt-1 font-medium">Cadastre opções para sua vitrine.</p>
        </div>
        
        <form action="/barbearia-app/admin/servicos/cadastrar" method="POST" class="p-6 md:p-8 space-y-5">
            
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Nome do Procedimento</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                        <i class="fa-solid fa-heading"></i>
                    </div>
                    <input type="text" name="nome" placeholder="Ex: Corte Degradê + Barba" required 
                           class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all placeholder:font-medium placeholder:text-gray-400">
                </div>
            </div>
            
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Descrição Visível (Opcional)</label>
                <textarea name="descricao" rows="2" placeholder="O que está incluso neste serviço?" 
                          class="w-full p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-medium text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all custom-scrollbar placeholder:text-gray-400 resize-none"></textarea>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Preço (R$)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-green-500 font-black text-sm">
                            R$
                        </div>
                        <input type="number" step="0.01" name="preco" placeholder="35.00" required 
                               class="w-full pl-10 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-green-50 dark:bg-green-500/5 text-green-700 dark:text-green-400 text-base font-black focus:ring-2 focus:ring-green-500/50 focus:border-green-500 outline-none transition-all placeholder:text-green-300">
                    </div>
                </div>
                
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Tempo (Minutos)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                            <i class="fa-regular fa-clock"></i>
                        </div>
                        <input type="number" name="duracao_minutos" value="30" required 
                               class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-base font-black text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all">
                    </div>
                </div>
            </div>
            
            <div class="pt-6 border-t border-gray-100 dark:border-gray-700/50 flex gap-3 mt-6">
                <button type="button" onclick="toggleModal('modalServico')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-black hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">Cancelar</button>
                <button type="submit" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black shadow-lg shadow-blue-500/30 hover:scale-[1.02] transition-all">Criar Serviço</button>
            </div>
        </form>
    </div>
</div>

<div id="modalEditarServico" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden border border-gray-100 dark:border-gray-700">
        
        <div class="bg-gradient-to-br from-gray-800 to-black p-8 text-white relative overflow-hidden">
            <button onclick="toggleModal('modalEditarServico')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-2xl font-black tracking-tight"><i class="fa-solid fa-pen-to-square mr-2"></i>Editar Serviço</h3>
            <p class="text-gray-300 text-sm mt-1 font-medium">Ajuste os valores do catálogo na hora.</p>
        </div>
        
        <form id="formEditarServico" method="POST" class="p-6 md:p-8 space-y-5">
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Nome do Procedimento</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-gray-800 dark:group-focus-within:text-white transition-colors">
                        <i class="fa-solid fa-heading"></i>
                    </div>
                    <input type="text" id="edit_nome" name="nome" required 
                           class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-gray-800 dark:focus:ring-gray-200 outline-none transition-all">
                </div>
            </div>
            
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Descrição</label>
                <textarea id="edit_descricao" name="descricao" rows="2" 
                          class="w-full p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-medium text-gray-800 dark:text-white focus:ring-2 focus:ring-gray-800 dark:focus:ring-gray-200 outline-none transition-all custom-scrollbar resize-none"></textarea>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Preço (R$)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-green-500 font-black text-sm">R$</div>
                        <input type="number" step="0.01" id="edit_preco" name="preco" required 
                               class="w-full pl-10 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-green-50 dark:bg-green-500/5 text-green-700 dark:text-green-400 text-base font-black focus:ring-2 focus:ring-green-500/50 outline-none transition-all">
                    </div>
                </div>
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Tempo (Min)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-gray-800 dark:group-focus-within:text-white transition-colors">
                            <i class="fa-regular fa-clock"></i>
                        </div>
                        <input type="number" id="edit_duracao" name="duracao_minutos" required 
                               class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-base font-black text-gray-800 dark:text-white focus:ring-2 focus:ring-gray-800 dark:focus:ring-gray-200 outline-none transition-all">
                    </div>
                </div>
            </div>
            
            <div class="pt-6 border-t border-gray-100 dark:border-gray-700/50 flex gap-3 mt-6">
                <button type="button" onclick="toggleModal('modalEditarServico')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-black hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">Cancelar</button>
                <button type="submit" class="w-full py-3.5 bg-gray-900 hover:bg-black dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 rounded-xl font-black shadow-lg shadow-gray-900/20 hover:scale-[1.02] transition-all">Atualizar Serviço</button>
            </div>
        </form>
    </div>
</div>

<div id="modalExcluirServico" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl max-w-sm w-full mx-4 p-8 shadow-2xl text-center transform scale-95 transition-transform duration-300">
        
        <div class="relative w-24 h-24 mx-auto mb-6">
            <div class="absolute inset-0 bg-red-500 rounded-full blur-xl opacity-20 animate-pulse"></div>
            <div class="relative w-full h-full bg-red-50 dark:bg-red-500/10 border-4 border-red-100 dark:border-red-500/20 text-red-500 rounded-full flex items-center justify-center text-4xl shadow-inner">
                <i class="fa-solid fa-trash-can"></i>
            </div>
        </div>
        
        <h3 class="text-2xl font-black mb-2 text-gray-900 dark:text-white tracking-tight">Remover do Catálogo?</h3>
        
        <p class="text-gray-500 dark:text-gray-400 mb-8 text-sm font-medium leading-relaxed">
            Você está prestes a apagar o serviço <br>
            <strong id="nomeServicoExcluir" class="text-gray-900 dark:text-white text-lg block mt-2"></strong>
            <span class="block mt-4 text-[10px] font-black uppercase tracking-widest text-red-500 bg-red-50 dark:bg-red-900/20 py-2 rounded-lg border border-red-100 dark:border-red-800/30">Ação irreversível</span>
        </p>
        
        <div class="flex gap-3">
            <button onclick="toggleModal('modalExcluirServico')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-xl font-black transition-colors">Voltar</button>
            <a id="btnConfirmarExclusaoServico" href="#" class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white rounded-xl font-black shadow-lg shadow-red-500/30 hover:scale-[1.02] transition-all flex items-center justify-center">
                Sim, Remover
            </a>
        </div>
    </div>
</div>

<script src="/barbearia-app/js/servico_admin.js"></script>
<script src="/barbearia-app/js/theme.js"></script>
</body>
</html>