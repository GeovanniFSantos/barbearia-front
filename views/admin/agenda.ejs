<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> <%= barbearia.nome %> - Agenda de Serviços</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' };
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
        .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; }
    </style>
</head>
<body class="bg-gray-50 dark:bg-[#0f141e] text-gray-800 dark:text-gray-100 transition-colors duration-300 font-sans">

    <%- include('../partials/sidebar') %>

        <main class="p-4 md:p-8 max-w-[1400px] mx-auto w-full">
            
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-5 animate-slide-up" <%- `style="animation-delay: 0s;"` %>>
                <div>
                    <h3 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50 shadow-sm">
                            <i class="fa-solid fa-calendar-days text-xl"></i>
                        </div>
                        Agenda de Serviços
                    </h3>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-2 ml-[3.25rem]">Controle os horários, serviços e vendas extras do dia.</p>
                </div>
                
                <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto bg-white dark:bg-gray-800 p-2 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700/60">
                    <form action="/barbearia-app/admin/agenda" method="GET" class="w-full sm:w-auto flex-1">
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                <i class="fa-regular fa-calendar"></i>
                            </div>
                            <input type="date" name="data" value="<%= dataFiltro %>" onchange="this.form.submit()" 
                                   class="w-full sm:w-48 py-3 pl-10 pr-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-700 dark:text-gray-200 focus:ring-2 focus:ring-blue-500 shadow-inner cursor-pointer outline-none transition-all">
                        </div>
                    </form>

                    <button onclick="toggleModal('modalNovoAgendamento')" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-blue-500/20 transition-all hover:scale-[1.02] flex items-center justify-center whitespace-nowrap">
                        <i class="fa-solid fa-plus mr-2"></i> Novo Encaixe
                    </button>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700/60 overflow-hidden animate-slide-up" <%- `style="animation-delay: 0.1s;"` %>>
                <div class="overflow-x-auto custom-scrollbar pb-2">
                    <table class="w-full text-left min-w-[900px]">
                        <thead class="bg-gray-50/50 dark:bg-gray-700/30 border-b-2 border-gray-100 dark:border-gray-700/50">
                            <tr>
                                <th class="py-5 px-6 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Horário</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Cliente</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Detalhes & Pagamento</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Profissional</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Status</th>
                                <th class="py-5 px-6 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 dark:divide-gray-700/30">
                            <% if (agendamentos.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="py-20 text-center">
                                        <div class="w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-300 dark:text-gray-600 text-2xl">
                                            <i class="fa-regular fa-calendar-xmark"></i>
                                        </div>
                                        <p class="text-gray-400 font-bold text-lg">Agenda livre neste dia.</p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% agendamentos.forEach(a => { 
                                    const horaFormatada = new Date(a.data_hora).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                                %>
                                    <tr class="hover:bg-gray-50/80 dark:hover:bg-gray-700/20 transition-colors group">
                                        
                                        <td class="py-4 px-6">
                                            <div class="inline-block px-4 py-2 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800/30 font-black text-blue-700 dark:text-blue-400 text-lg shadow-sm">
                                                <%= horaFormatada %>
                                            </div>
                                        </td>

                                        <td class="py-4 px-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 flex items-center justify-center text-sm font-black text-gray-600 dark:text-gray-300 shadow-inner">
                                                    <%= a.cliente_nome ? a.cliente_nome[0].toUpperCase() : 'C' %>
                                                </div>
                                                <span class="block font-black text-gray-900 dark:text-white text-base"><%= a.cliente_nome || 'Cliente Local' %></span>
                                            </div>
                                        </td>

                                        <td class="py-4 px-4">
                                            <div class="flex flex-col gap-1.5 mb-2">
                                                <span class="font-bold text-gray-800 dark:text-gray-200 text-sm"><%= a.servico_nome %></span>
                                                <% if(a.produto_nome) { %>
                                                    <span class="inline-flex w-max items-center gap-1.5 px-2 py-0.5 rounded-lg bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-100 dark:border-indigo-800/30 text-[10px] font-black text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">
                                                        <i class="fa-solid fa-box-open"></i> + <%= a.produto_nome %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            
                                            <div class="flex items-center gap-2">
                                                <span class="text-xs font-black text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20 px-2 py-1 rounded-md border border-green-100 dark:border-green-800/30 shadow-sm">
                                                    R$ <%= Number(a.valor_total).toFixed(2) %>
                                                </span>
                                                <span class="inline-flex items-center text-[10px] uppercase font-bold text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded-md border border-gray-200 dark:border-gray-600">
                                                    <% if (a.forma_pagamento && a.forma_pagamento.toLowerCase().includes('pix')) { %>
                                                        <i class="fa-brands fa-pix text-teal-500 mr-1.5"></i> Pix
                                                    <% } else if (a.forma_pagamento === 'App' || a.forma_pagamento === 'Mercado Pago') { %>
                                                        <i class="fa-solid fa-mobile-screen-button text-indigo-500 mr-1.5"></i> App
                                                    <% } else if (a.forma_pagamento === 'Dinheiro') { %>
                                                        <i class="fa-solid fa-money-bill-wave text-emerald-500 mr-1.5"></i> <%= a.forma_pagamento %>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-credit-card text-blue-500 mr-1.5"></i> <%= a.forma_pagamento || 'Local' %>
                                                    <% } %>
                                                </span>
                                            </div>
                                        </td>

                                        <td class="py-4 px-4 text-sm font-bold text-gray-500 dark:text-gray-400">
                                            <%= a.profissional_nome %>
                                        </td>

                                        <td class="py-4 px-4 text-center">
                                            <% if (a.status === 'agendado') { %>
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest bg-amber-50 text-amber-600 border border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Aguardando
                                                </span>
                                            <% } else if (a.status === 'concluido' || a.status === 'pago') { %>
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest bg-green-50 text-green-600 border border-green-200 dark:bg-green-500/10 dark:text-green-400 dark:border-green-500/20">
                                                    <i class="fa-solid fa-check text-green-500"></i> Concluído
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest bg-red-50 text-red-600 border border-red-200 dark:bg-red-500/10 dark:text-red-400 dark:border-red-500/20">
                                                    <i class="fa-solid fa-xmark text-red-500"></i> Cancelado
                                                </span>
                                            <% } %>
                                        </td>

                                        <td class="py-4 px-6 text-center">
                                            <div class="flex justify-center space-x-2">
                                                <% if (a.status === 'agendado') { %>
                                                    <a href="/barbearia-app/admin/agenda/status/<%= a.id %>?status=concluido" class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-400 hover:bg-green-500 hover:border-green-500 hover:text-white hover:shadow-lg hover:shadow-green-500/30 flex items-center justify-center transition-all hover:scale-110" title="Finalizar Atendimento">
                                                        <i class="fa-solid fa-check"></i>
                                                    </a>
                                                    <button type="button" class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-400 hover:bg-red-500 hover:border-red-500 hover:text-white hover:shadow-lg hover:shadow-red-500/30 flex items-center justify-center transition-all hover:scale-110" title="Cancelar Horário" onclick="abrirModalCancelarHorario('<%= a.id %>')">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-gray-300 dark:text-gray-600 text-xl"><i class="fa-solid fa-minus"></i></span>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<div id="modalNovoAgendamento" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden border border-gray-100 dark:border-gray-700 max-h-[95vh] overflow-y-auto custom-scrollbar" id="modalNovoContent">
        
        <div class="bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 p-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-32 h-32 bg-white opacity-10 rounded-full blur-2xl"></div>
            <button onclick="toggleModal('modalNovoAgendamento')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-2xl font-black tracking-tight"><i class="fa-solid fa-calendar-plus mr-2"></i>Novo Horário</h3>
            <p class="text-blue-100 text-sm mt-1 font-medium">Faça o encaixe manual do cliente.</p>
        </div>
        
        <form action="/barbearia-app/admin/agenda/cadastrar" method="POST" class="p-6 md:p-8 space-y-5">
            <!-- Cliente -->
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">1. Cliente</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500"><i class="fa-solid fa-user"></i></div>
                    <select name="cliente_id" required class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all cursor-pointer appearance-none text-gray-800 dark:text-white">
                        <option value="">Buscar na base...</option>
                        <% clientes.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.nome %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <!-- Serviço -->
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">2. Serviço</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500"><i class="fa-solid fa-scissors"></i></div>
                    <!-- Adicionado ID e onchange -->
                    <select name="servico_id" id="selectServico" onchange="calcularTotalPrevisto()" required class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all cursor-pointer appearance-none text-gray-800 dark:text-white">
                        <option value="" data-preco="0">Escolher serviço...</option>
                        <% servicos.forEach(s => { %>
                            <!-- Adicionado data-preco -->
                            <option value="<%= s.id %>" data-preco="<%= s.preco %>"><%= s.nome %> (R$ <%= Number(s.preco).toFixed(2) %>)</option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <!-- Produto -->
            <div class="group bg-indigo-50/50 dark:bg-indigo-900/10 p-4 rounded-2xl border border-indigo-100 dark:border-indigo-800/30">
                <label class="block text-[10px] font-black text-indigo-500 tracking-widest uppercase mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-cart-plus"></i> Comprou Produto? <span class="text-[8px] text-gray-400 normal-case">(Opcional)</span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-indigo-400"><i class="fa-solid fa-box-open"></i></div>
                    <!-- Adicionado ID e onchange -->
                    <select name="id_produto" id="selectProduto" onchange="calcularTotalPrevisto()" class="w-full pl-11 p-3.5 rounded-xl border border-indigo-200 dark:border-indigo-700/50 bg-white dark:bg-gray-800 text-sm font-bold focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer appearance-none text-gray-800 dark:text-white">
                        <option value="" data-preco="0">Apenas o Serviço</option>
                        <% if (typeof produtos !== 'undefined') { %>
                            <% produtos.forEach(p => { %>
                                <!-- Adicionado data-preco -->
                                <option value="<%= p.id %>" data-preco="<%= p.preco %>"><%= p.nome %> (+ R$ <%= Number(p.preco).toFixed(2) %>)</option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
            </div>

            <!-- TOTALIZADOR DINÂMICO (NOVO) -->
            <div class="flex justify-between items-center bg-gray-50 dark:bg-gray-900/50 p-4 rounded-xl border border-gray-200 dark:border-gray-700">
                <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest"><i class="fa-solid fa-calculator mr-1"></i> Valor Total</span>
                <span class="text-2xl font-black text-green-500 transition-all" id="displayValorTotal">R$ 0,00</span>
            </div>

            <!-- Dados Finais -->
            <div class="grid grid-cols-2 gap-4 pt-2">
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Profissional</label>
                    <select name="colaborador_id" required class="w-full p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all cursor-pointer text-gray-800 dark:text-white">
                        <% colaboradores.forEach(colab => { %>
                            <option value="<%= colab.id %>"><%= colab.nome %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Data e Hora</label>
                    <input type="datetime-local" name="data_hora" value="<%= typeof dataFiltro !== 'undefined' ? dataFiltro + 'T12:00' : '' %>" required class="w-full p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all cursor-pointer text-gray-800 dark:text-white">
                </div>
            </div>

            <div class="pt-6 border-t border-gray-100 dark:border-gray-700/50 flex gap-3 mt-6">
                <button type="button" onclick="toggleModal('modalNovoAgendamento')" class="w-full py-4 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-black hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">Cancelar</button>
                <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black shadow-lg shadow-blue-500/30 hover:scale-[1.02] transition-all">Salvar Horário</button>
            </div>
        </form>
    </div>
</div>

<div id="modalCancelarHorario" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl max-w-sm w-full mx-4 p-8 shadow-2xl text-center transform scale-95 transition-transform duration-300" id="modalCancelarContent">
        
        <div class="relative w-24 h-24 mx-auto mb-6">
            <div class="absolute inset-0 bg-red-500 rounded-full blur-xl opacity-20 animate-pulse"></div>
            <div class="relative w-full h-full bg-red-50 dark:bg-red-500/10 border-4 border-red-100 dark:border-red-500/20 text-red-500 rounded-full flex items-center justify-center text-4xl shadow-inner">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>
        
        <h3 class="text-2xl font-black mb-2 text-gray-900 dark:text-white">Cancelar Horário?</h3>
        <p class="text-gray-500 dark:text-gray-400 mb-6 text-sm font-medium">Esta ação removerá o agendamento da agenda e notificará o cliente.</p>

        <div class="bg-red-50 dark:bg-red-900/20 p-4 rounded-2xl mb-8 border border-red-100 dark:border-red-800/30 text-xs text-red-700 dark:text-red-400 text-left flex gap-3">
            <i class="fa-solid fa-circle-info text-base mt-0.5"></i>
            <span class="leading-relaxed">Se o cliente pagou pelo App, o valor será <strong>estornado automaticamente</strong>.</span>
        </div>
        
        <input type="hidden" id="agendamentoCancelamentoId">
        
        <div class="flex gap-3">
            <button onclick="toggleModal('modalCancelarHorario')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-xl font-black transition-colors">Voltar</button>
            <button id="btnConfirmarCancelarHorario" onclick="executarCancelamentoAutomacao()" class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white rounded-xl font-black shadow-lg shadow-red-500/30 hover:scale-[1.02] transition-all flex items-center justify-center">
                Sim, Cancelar
            </button>
        </div>
    </div>
</div>

<div id="modalFeedbackCancelamento" class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl max-w-sm w-full mx-4 p-8 shadow-2xl text-center transform scale-95 transition-transform duration-300" id="modalFeedbackContent">
        <div id="feedbackIcon" class="text-6xl mb-4"></div>
        <h3 id="feedbackTitle" class="text-2xl font-black mb-2 text-gray-800 dark:text-white"></h3>
        <p id="feedbackMessage" class="text-gray-500 dark:text-gray-400 mb-8 font-medium text-sm"></p>
        <button onclick="fecharFeedbackERecarregar()" class="w-full px-4 py-3.5 bg-gray-900 dark:bg-gray-700 hover:bg-black text-white rounded-xl font-black shadow-lg transition-colors">
            Entendido
        </button>
    </div>
</div>

<script src="/barbearia-app/js/agenda_admin.js"></script>
<script src="/barbearia-app/js/theme.js"></script>

</body>
</html>