<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe de Profissionais - Gestão</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="shortcut icon" type="imagex/png" href="./public/img/LogoPrincipal_Trasparente.png"/>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' };
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
        .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; }
    </style>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-88775JZJQS"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-88775JZJQS');
    </script>
</head>
<body class="bg-gray-50 dark:bg-[#0f141e] text-gray-800 dark:text-gray-100 transition-colors duration-300 font-sans">

    <%- include('../partials/sidebar') %>

        <main class="p-4 md:p-8 max-w-7xl mx-auto w-full">
            
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-5 animate-slide-up" <%- `style="animation-delay: 0s;"` %>>
                <div>
                    <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50 shadow-sm">
                            <i class="fa-solid fa-user-tie text-xl"></i>
                        </div>
                        Equipe de Profissionais
                    </h2>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-2 ml-[3.25rem]">Gerencie os barbeiros, acessos e acompanhe a performance.</p>
                </div>
                
                <button onclick="toggleModal('modalColaborador')" class="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-blue-500/20 transition-all hover:scale-[1.02] flex items-center justify-center whitespace-nowrap">
                    <i class="fa-solid fa-user-plus mr-2"></i> Novo Profissional
                </button>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700/60 overflow-hidden animate-slide-up" <%- `style="animation-delay: 0.1s;"` %>>
                <div class="overflow-x-auto custom-scrollbar pb-2">
                    <table class="w-full text-left min-w-[800px]">
                        <thead class="bg-gray-50/50 dark:bg-gray-700/30 border-b-2 border-gray-100 dark:border-gray-700/50">
                            <tr>
                                <th class="py-5 px-6 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Profissional</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Cortes (Mês)</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Faturamento (Mês)</th>
                                <th class="py-5 px-4 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Contato</th>
                                <th class="py-5 px-6 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 dark:divide-gray-700/30">
                            <% if (colaboradores.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="py-16 text-center">
                                        <div class="w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-300 dark:text-gray-600 text-2xl">
                                            <i class="fa-solid fa-users-slash"></i>
                                        </div>
                                        <p class="text-gray-400 font-bold">Nenhum profissional cadastrado na equipa.</p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% colaboradores.forEach(c => { %>
                                    <tr class="hover:bg-gray-50/80 dark:hover:bg-gray-700/20 transition-colors group">
                                        
                                        <td class="py-4 px-6">
                                            <div class="flex items-center gap-4">
                                                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white flex justify-center items-center text-lg font-black shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform">
                                                    <%= c.nome.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <span class="block font-black text-gray-900 dark:text-white text-base"><%= c.nome %></span>
                                                    <span class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest"><%= c.email %></span>
                                                </div>
                                            </div>
                                        </td>
                                        
                                        <td class="py-4 px-4 text-center">
                                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gray-100 dark:bg-gray-700/50 font-black text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-600">
                                                <%= c.cortes_mes %>
                                            </span>
                                        </td>
                                        
                                        <td class="py-4 px-4 text-center">
                                            <span class="inline-block text-sm font-black text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-500/10 px-3 py-1.5 rounded-lg border border-green-100 dark:border-green-500/20 shadow-sm">
                                                <%= c.faturamento_mes_fmt %>
                                            </span>
                                        </td>
                                        
                                        <td class="py-4 px-4 text-center">
                                            <% if(c.telefone) { %>
                                                <a href="https://wa.me/55<%= c.telefone.replace(/\D/g, '') %>" target="_blank" class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-green-50 dark:bg-green-500/10 text-green-500 hover:bg-green-500 hover:text-white transition-all hover:scale-110 hover:rotate-3 shadow-sm hover:shadow-green-500/30" title="Chamar no WhatsApp">
                                                    <i class="fa-brands fa-whatsapp text-xl"></i>
                                                </a>
                                            <% } else { %>
                                                <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-300 dark:text-gray-600">
                                                    <i class="fa-brands fa-whatsapp text-xl"></i>
                                                </span>
                                            <% } %>
                                        </td>
                                        
                                        <td class="py-4 px-6 text-center">
                                            <div class="flex justify-center gap-2">
                                                <button onclick="abrirModalPerformance('<%= c.nome %>', '<%= c.cortes_mes %>', '<%= c.faturamento_hoje_fmt %>', '<%= c.faturamento_semana_fmt %>', '<%= c.faturamento_mes_fmt %>', '<%= c.faturamento_ano_fmt %>')" 
                                                        class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-900/20 border border-purple-100 dark:border-purple-800/30 text-purple-600 hover:bg-purple-600 hover:text-white flex items-center justify-center transition-all hover:scale-110 shadow-sm hover:shadow-purple-500/30" title="Ver Performance">
                                                    <i class="fa-solid fa-chart-column"></i>
                                                </button>
                                                <button onclick="abrirModalEditarColaborador('<%= c.id %>', '<%= c.nome %>', '<%= c.telefone %>')" 
                                                        class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800/30 text-blue-600 hover:bg-blue-600 hover:text-white flex items-center justify-center transition-all hover:scale-110 shadow-sm hover:shadow-blue-500/30" title="Editar Dados">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button onclick="abrirModalExcluirColaborador('<%= c.id %>', '<%= c.nome %>')" 
                                                        class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-600 hover:bg-red-600 hover:text-white flex items-center justify-center transition-all hover:scale-110 shadow-sm hover:shadow-red-500/30" title="Remover da Equipe">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<div id="modalPerformance" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden border border-gray-100 dark:border-gray-700">
        
        <div class="bg-gradient-to-br from-purple-600 to-indigo-800 p-8 text-white relative overflow-hidden text-center">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-32 h-32 bg-white opacity-10 rounded-full blur-2xl"></div>
            
            <button onclick="toggleModal('modalPerformance')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <div class="w-20 h-20 mx-auto rounded-3xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-4xl font-black mb-4 border-2 border-white/40 shadow-xl" id="perfLetra"></div>
            <h3 class="text-2xl font-black tracking-tight" id="perfNome"></h3>
            <p class="text-purple-100 text-xs font-bold uppercase tracking-widest mt-2 opacity-90"><i class="fa-solid fa-ranking-star mr-1"></i> Resumo de Faturamento</p>
        </div>

        <div class="p-6">
            <div class="bg-purple-50 dark:bg-purple-900/20 rounded-2xl p-5 mb-6 border border-purple-100 dark:border-purple-800/50 shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3 text-purple-700 dark:text-purple-400">
                    <i class="fa-solid fa-scissors text-xl"></i>
                    <span class="text-xs font-black uppercase tracking-widest">Cortes no Mês</span>
                </div>
                <span class="text-3xl font-black text-purple-600 dark:text-purple-400" id="perfCortes"></span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="bg-gray-50 dark:bg-gray-700/30 p-4 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1"><i class="fa-solid fa-calendar-day mr-1"></i> Ganhos Hoje</p>
                    <p class="text-xl font-black text-green-500" id="perfHoje"></p>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700/30 p-4 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1"><i class="fa-solid fa-calendar-week mr-1"></i> Esta Semana</p>
                    <p class="text-xl font-black text-gray-800 dark:text-white" id="perfSemana"></p>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700/30 p-4 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1"><i class="fa-regular fa-calendar mr-1"></i> Este Mês</p>
                    <p class="text-xl font-black text-blue-500" id="perfMes"></p>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700/30 p-4 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1"><i class="fa-solid fa-calendar-days mr-1"></i> Este Ano</p>
                    <p class="text-xl font-black text-gray-800 dark:text-white" id="perfAno"></p>
                </div>
            </div>
            
            <button onclick="toggleModal('modalPerformance')" class="mt-6 w-full py-4 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-black hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Fechar Resumo
            </button>
        </div>
    </div>
</div>

<div id="modalColaborador" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden border border-gray-100 dark:border-gray-700">
        
        <div class="bg-gradient-to-br from-blue-600 to-indigo-800 p-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-32 h-32 bg-white opacity-10 rounded-full blur-2xl"></div>
            <button onclick="toggleModal('modalColaborador')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-2xl font-black tracking-tight"><i class="fa-solid fa-user-plus mr-2"></i>Novo Profissional</h3>
            <p class="text-blue-100 text-sm mt-1 font-medium">Crie o acesso para um novo barbeiro.</p>
        </div>
        
        <form action="/barbearia-app/admin/colaboradores/cadastrar" method="POST" class="p-6 md:p-8 space-y-5">
            
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Nome Completo</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors"><i class="fa-solid fa-user"></i></div>
                    <input type="text" name="nome" placeholder="Ex: João Silva" required 
                           class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all placeholder:text-gray-400">
                </div>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Telefone</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors"><i class="fa-solid fa-phone"></i></div>
                        <input type="text" name="telefone" placeholder="00000-0000" required 
                               class="w-full pl-10 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all placeholder:text-gray-400">
                    </div>
                </div>
                <div class="group">
                    <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">E-mail (Login)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors"><i class="fa-solid fa-envelope"></i></div>
                        <input type="email" name="email" placeholder="email@ex.com" required 
                               class="w-full pl-9 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all placeholder:text-gray-400">
                    </div>
                </div>
            </div>

            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Senha Padrão de Acesso</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors"><i class="fa-solid fa-lock"></i></div>
                    <input type="password" name="password" placeholder="••••••••" required 
                           class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 outline-none transition-all">
                </div>
                <p class="text-[10px] font-bold text-gray-400 mt-2"><i class="fa-solid fa-circle-info mr-1"></i>O barbeiro usará esta senha para aceder à sua própria agenda.</p>
            </div>
            
            <div class="pt-6 border-t border-gray-100 dark:border-gray-700/50 flex gap-3 mt-6">
                <button type="button" onclick="toggleModal('modalColaborador')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-black hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">Cancelar</button>
                <button type="submit" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black shadow-lg shadow-blue-500/30 hover:scale-[1.02] transition-all">Salvar Equipe</button>
            </div>
        </form>
    </div>
</div>

<div id="modalEditarColaborador" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden border border-gray-100 dark:border-gray-700">
        
        <div class="bg-gradient-to-br from-gray-800 to-black p-8 text-white relative overflow-hidden">
            <button onclick="toggleModal('modalEditarColaborador')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-2xl font-black tracking-tight"><i class="fa-solid fa-pen-to-square mr-2"></i>Editar Profissional</h3>
            <p class="text-gray-300 text-sm mt-1 font-medium">Atualize os dados de contato.</p>
        </div>
        
        <form id="formEditarColaborador" method="POST" class="p-6 md:p-8 space-y-5">
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Nome Completo</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-gray-800 dark:group-focus-within:text-white transition-colors"><i class="fa-solid fa-user"></i></div>
                    <input type="text" id="edit_colab_nome" name="nome" required 
                           class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-gray-800 dark:focus:ring-gray-200 outline-none transition-all">
                </div>
            </div>
            
            <div class="group">
                <label class="block text-[10px] font-black text-gray-500 tracking-widest uppercase mb-2">Telefone / WhatsApp</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-gray-800 dark:group-focus-within:text-white transition-colors"><i class="fa-solid fa-phone"></i></div>
                    <input type="text" id="edit_colab_telefone" name="telefone" required 
                           class="w-full pl-11 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm font-bold text-gray-800 dark:text-white focus:ring-2 focus:ring-gray-800 dark:focus:ring-gray-200 outline-none transition-all">
                </div>
            </div>
            
            <div class="pt-6 border-t border-gray-100 dark:border-gray-700/50 flex gap-3 mt-6">
                <button type="button" onclick="toggleModal('modalEditarColaborador')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-black hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">Cancelar</button>
                <button type="submit" class="w-full py-3.5 bg-gray-900 hover:bg-black dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 rounded-xl font-black shadow-lg shadow-gray-900/20 hover:scale-[1.02] transition-all">Atualizar Dados</button>
            </div>
        </form>
    </div>
</div>

<div id="modalExcluirColaborador" class="fixed inset-0 bg-gray-900/80 backdrop-blur-md z-[9999] hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-3xl max-w-sm w-full mx-4 p-8 shadow-2xl text-center transform scale-95 transition-transform duration-300">
        
        <div class="relative w-24 h-24 mx-auto mb-6">
            <div class="absolute inset-0 bg-red-500 rounded-full blur-xl opacity-20 animate-pulse"></div>
            <div class="relative w-full h-full bg-red-50 dark:bg-red-500/10 border-4 border-red-100 dark:border-red-500/20 text-red-500 rounded-full flex items-center justify-center text-4xl shadow-inner">
                <i class="fa-solid fa-user-xmark"></i>
            </div>
        </div>
        
        <h3 class="text-2xl font-black mb-2 text-gray-900 dark:text-white tracking-tight">Remover da Equipe?</h3>
        
        <p class="text-gray-500 dark:text-gray-400 mb-8 text-sm font-medium leading-relaxed">
            Tem a certeza que deseja remover o acesso de <br>
            <strong id="nomeColaboradorExcluir" class="text-gray-900 dark:text-white text-lg block mt-2"></strong>
            <span class="block mt-4 text-[10px] font-black uppercase tracking-widest text-red-500 bg-red-50 dark:bg-red-900/20 py-2 rounded-lg border border-red-100 dark:border-red-800/30">O profissional perderá o acesso ao painel</span>
        </p>
        
        <div class="flex gap-3">
            <button onclick="toggleModal('modalExcluirColaborador')" class="w-full py-3.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-xl font-black transition-colors">Cancelar</button>
            <a id="btnConfirmarExclusaoColaborador" href="#" class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white rounded-xl font-black shadow-lg shadow-red-500/30 hover:scale-[1.02] transition-all flex items-center justify-center">
                Sim, Remover
            </a>
        </div>
    </div>
</div>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8127173362225481"
    crossorigin="anonymous"></script>
    <script src="/barbearia-app/public/js/colaboradores_admin.js"></script>
