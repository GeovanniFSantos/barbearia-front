<% 
    let isAgenda = typeof agendamentos !== 'undefined';
    let isPerfil = typeof cliente !== 'undefined';
    let isLoja = typeof servicos !== 'undefined' || (!isAgenda && !isPerfil);
%>

<nav class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100 dark:border-gray-800">
    <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
        
        <a href="/barbearia-app/barbearia/" class="flex items-center gap-2 group">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm shadow-md group-hover:bg-blue-700 transition-colors">
                <i class="fa-solid fa-scissors"></i>
            </div>
            <h1 class="text-xl font-black text-gray-800 dark:text-white tracking-tight">
                <%= typeof barbearia !== 'undefined' ? barbearia.nome : 'Barbearia' %>
            </h1>
        </a>
        
        <div class="hidden md:flex items-center space-x-6">
            <a href="/barbearia-app/barbearia/" class="text-sm font-bold transition-colors <%= isLoja ? 'text-blue-600 dark:text-blue-400' : 'text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400' %>">
                <i class="fa-solid fa-store mr-1"></i> Vitrine
            </a>
            
            <% if (typeof clienteLogado !== 'undefined' && clienteLogado) { %>
                <a href="/barbearia-app/barbearia/meus-agendamentos" class="text-sm font-bold transition-colors <%= isAgenda ? 'text-blue-600 dark:text-blue-400' : 'text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400' %>">
                    <i class="fa-regular fa-calendar-check mr-1"></i> Agenda
                </a>
            <% } %>
            
            <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>
            
            <button id="theme-toggle" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800">
                <span id="theme-icon" class="text-sm">🌙</span>
            </button>

            <% if (typeof clienteLogado !== 'undefined' && clienteLogado) { %>
                <a href="/barbearia-app/barbearia/meu-perfil" class="flex items-center gap-2 text-sm font-bold px-4 py-2 rounded-xl transition-all <%= isPerfil ? 'bg-blue-600 text-white shadow-md' : 'bg-blue-50 hover:bg-blue-100 dark:bg-blue-900/30 dark:hover:bg-blue-900/50 text-blue-700 dark:text-blue-400' %>">
                    <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs <%= isPerfil ? 'bg-white/20 text-white' : 'bg-blue-200 dark:bg-blue-800 text-blue-800 dark:text-blue-200' %>">
                        <%= typeof nomeCliente !== 'undefined' ? nomeCliente.charAt(0).toUpperCase() : 'C' %>
                    </div>
                    <%= typeof nomeCliente !== 'undefined' ? nomeCliente.split(' ')[0] : 'Cliente' %>
                </a>
            <% } else { %>
                <a href="/barbearia-app/auth/login" class="text-sm font-black bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl transition-all shadow-md hover:shadow-blue-500/30">
                    Entrar <i class="fa-solid fa-arrow-right-to-bracket ml-1"></i>
                </a>
            <% } %>
        </div>

        <div class="md:hidden flex items-center">
            <button id="theme-toggle-mobile" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white transition-colors w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
                <span id="theme-icon-mobile" class="text-sm">🌙</span>
            </button>
        </div>

    </div>
</nav>

<div class="md:hidden fixed bottom-5 left-1/2 -translate-x-1/2 w-[92%] max-w-sm z-[90]">
    <div class="bg-[#0B1121]/95 backdrop-blur-xl border border-gray-700/50 shadow-2xl rounded-2xl px-2 py-3 flex justify-around items-center">
        
        <a href="/barbearia-app/barbearia/" class="flex flex-col items-center gap-1 w-14 transition-colors relative <%= isLoja ? 'text-blue-400' : 'text-gray-400 hover:text-white' %>">
            <% if (isLoja) { %> <div class="absolute -top-4 bg-blue-600/20 w-12 h-12 rounded-full blur-md"></div> <% } %>
            <i class="fa-solid fa-store <%= isLoja ? 'text-xl text-blue-500' : 'text-lg' %> relative z-10 transition-all"></i>
            <span class="text-[9px] font-black uppercase tracking-wider mt-0.5 relative z-10">Loja</span>
        </a>

        <% if (typeof clienteLogado !== 'undefined' && clienteLogado) { %>
            <a href="/barbearia-app/barbearia/meus-agendamentos" class="flex flex-col items-center gap-1 w-14 transition-colors relative <%= isAgenda ? 'text-blue-400' : 'text-gray-400 hover:text-white' %>">
                <% if (isAgenda) { %> <div class="absolute -top-4 bg-blue-600/20 w-12 h-12 rounded-full blur-md"></div> <% } %>
                <i class="fa-regular fa-calendar-check <%= isAgenda ? 'text-xl text-blue-500' : 'text-lg' %> relative z-10 transition-all"></i>
                <span class="text-[9px] font-black uppercase tracking-wider mt-0.5 relative z-10">Agenda</span>
            </a>
            
            <a href="/barbearia-app/barbearia/meu-perfil" class="flex flex-col items-center gap-1 w-14 transition-colors relative <%= isPerfil ? 'text-blue-400' : 'text-gray-400 hover:text-white' %>">
                <% if (isPerfil) { %> <div class="absolute -top-4 bg-blue-600/20 w-12 h-12 rounded-full blur-md"></div> <% } %>
                <i class="fa-solid fa-user <%= isPerfil ? 'text-xl text-blue-500' : 'text-lg' %> relative z-10 transition-all"></i>
                <span class="text-[9px] font-black uppercase tracking-wider mt-0.5 relative z-10">Perfil</span>
            </a>

            <a href="/barbearia-app/auth/logout" class="flex flex-col items-center gap-1 w-14 text-red-400/70 hover:text-red-400 transition-colors">
                <i class="fa-solid fa-arrow-right-from-bracket text-lg"></i>
                <span class="text-[9px] font-black uppercase tracking-wider mt-0.5">Sair</span>
            </a>

        <% } else { %>
            <a href="/barbearia-app/auth/login" class="flex flex-col items-center gap-1 w-14 text-gray-400 hover:text-white transition-colors relative">
                <i class="fa-solid fa-arrow-right-to-bracket text-lg relative z-10"></i>
                <span class="text-[9px] font-black uppercase tracking-wider mt-0.5 relative z-10">Entrar</span>
            </a>
        <% } %>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleMobile = document.getElementById('theme-toggle-mobile');
        const iconMobile = document.getElementById('theme-icon-mobile');
        
        if(toggleMobile) {
            if (localStorage.getItem('theme') === 'dark' || document.documentElement.classList.contains('dark')) {
                iconMobile.textContent = '☀️';
            } else {
                iconMobile.textContent = '🌙';
            }

            toggleMobile.addEventListener('click', () => {
                const btnDesktop = document.getElementById('theme-toggle');
                if(btnDesktop) {
                    btnDesktop.click();
                    setTimeout(() => {
                        iconMobile.textContent = document.documentElement.classList.contains('dark') ? '☀️' : '🌙';
                    }, 50);
                }
            });
        }
    });
</script>