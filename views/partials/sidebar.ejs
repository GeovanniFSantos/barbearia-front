        <style>
            .hide-scrollbar::-webkit-scrollbar { display: none; }
            .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        </style>
        <script>
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('mobile-overlay');
                
                sidebar.classList.toggle('-translate-x-full');
                
                if (overlay.classList.contains('hidden')) {
                    overlay.classList.remove('hidden');
                    // Pequeno delay para a animação de fade-in funcionar
                    setTimeout(() => overlay.classList.remove('opacity-0'), 10);
                } else {
                    overlay.classList.add('opacity-0');
                    setTimeout(() => overlay.classList.add('hidden'), 300);
                }
            }

            // MOTOR DO SINO DE NOTIFICAÇÕES
            document.addEventListener("DOMContentLoaded", () => {
                carregarNotificacoesGlobais();
            });

            function toggleNotificacoesPanel() {
                const panel = document.getElementById('dropdownNotificacoes');
                
                if (panel.classList.contains('hidden')) {
                    panel.classList.remove('hidden');
                    setTimeout(() => {
                        panel.classList.remove('scale-95', 'opacity-0');
                        panel.classList.add('scale-100', 'opacity-100');
                    }, 10);
                    
                    document.getElementById('pingNotificacao').classList.add('hidden');
                    document.getElementById('pingNotificacaoSolido').classList.add('hidden');
                    document.getElementById('btnSinoNotificacao').classList.remove('text-blue-600', 'dark:text-blue-400');
                } else {
                    panel.classList.remove('scale-100', 'opacity-100');
                    panel.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => panel.classList.add('hidden'), 200);
                }
            }

            async function carregarNotificacoesGlobais() {
                try {
                    const response = await fetch('/barbearia-app/admin/notificacoes/api');
                    const data = await response.json();
                    const container = document.getElementById('listaNotificacoes');
                    
                    if (!data.notificacoes || data.notificacoes.length === 0) {
                        container.innerHTML = `
                            <div class="p-8 text-center text-gray-400 dark:text-gray-500">
                                <i class="fa-regular fa-bell-slash text-4xl mb-3 opacity-50"></i>
                                <p class="text-sm font-bold">Nenhuma atividade recente.</p>
                            </div>`;
                        return;
                    }

                    // Acende o sino
                    document.getElementById('pingNotificacao').classList.remove('hidden');
                    document.getElementById('pingNotificacaoSolido').classList.remove('hidden');
                    document.getElementById('btnSinoNotificacao').classList.add('text-blue-600', 'dark:text-blue-400');

                    container.innerHTML = '';
                    
                    data.notificacoes.forEach(notif => {
                        const tempo = calcularTempoAtras(new Date(notif.created_at));
                        const dataMarcada = new Date(notif.data_hora).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });

                        container.innerHTML += `
                            <div class="p-4 hover:bg-blue-50/50 dark:hover:bg-gray-700/30 transition-colors flex gap-4 group">
                                <div class="w-10 h-10 flex-shrink-0 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-600 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-calendar-check"></i>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-800 dark:text-gray-200 leading-tight">
                                        <strong class="font-black">${notif.cliente_nome}</strong> agendou <span class="font-bold text-blue-600 dark:text-blue-400">${notif.servico_nome}</span>
                                    </p>
                                    <div class="flex items-center gap-2 mt-1.5">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-md"><i class="fa-regular fa-clock mr-1"></i> ${dataMarcada}</span>
                                        <span class="text-[10px] font-bold text-gray-400 ml-auto">${tempo}</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                } catch (error) {
                    console.error('Erro ao buscar o sininho:', error);
                }
            }

            function calcularTempoAtras(dataAgendamento) {
                const segundos = Math.floor((new Date() - dataAgendamento) / 1000);
                if (segundos < 60) return "Agora mesmo";
                const minutos = Math.floor(segundos / 60);
                if (minutos < 60) return `Há ${minutos} min`;
                const horas = Math.floor(minutos / 60);
                if (horas < 24) return `Há ${horas} h`;
                return `Há ${Math.floor(horas / 24)} dias`;
            }
        </script>