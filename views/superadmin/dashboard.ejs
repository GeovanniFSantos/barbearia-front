<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solução Sob Medida - Barbearia-app</title>
    <link rel="shortcut icon" type="imagex/png" href="./public/img/LogoPrincipal_Trasparente.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' };
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
        .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 transition-colors duration-500">

    <nav class="bg-white/80 dark:bg-gray-800/80 glass-effect sticky top-0 z-40 shadow-sm border-b border-gray-200 dark:border-gray-700 p-4 flex justify-between items-center transition-all">
        <h1 class="text-2xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-500 tracking-tight">
            Solução Sob Medida <span class="text-sm font-medium text-gray-500 dark:text-gray-400 align-middle ml-1">CEO</span>
        </h1>
        <div class="flex items-center space-x-5">
            <span class="font-medium text-sm text-gray-600 dark:text-gray-300">Olá, <span class="font-bold text-gray-900 dark:text-white"><%= nome %></span></span>
            <button id="theme-toggle" class="p-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-full transition-colors shadow-inner">
                <span id="theme-icon">🌙</span>
            </button>
            <a href="/barbearia-app/auth/logout" class="bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-500/10 dark:hover:bg-red-500/20 dark:text-red-400 px-5 py-2 rounded-lg font-semibold text-sm transition-all border border-red-100 dark:border-red-500/20">Sair</a>
        </div>
    </nav>

    <main class="p-8 max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 tracking-tight text-gray-900 dark:text-white">Visão Global do Sistema</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100 dark:border-gray-700">
                <h3 class="text-sm text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider mb-2">Barbearias Ativas</h3>
                <p class="text-5xl font-black text-emerald-500"><%= totalBarbearias %></p>
            </div>
            
            <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100 dark:border-gray-700">
                <h3 class="text-sm text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider mb-2">Faturamento (MRR)</h3>
                <p class="text-5xl font-black text-blue-600 dark:text-blue-400"><%= faturamento %></p>
            </div>

            <div class="flex items-center">
                <button onclick="toggleModal('modalCadastro')" class="w-full h-full min-h-[120px] bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3 px-4 rounded-2xl shadow-lg hover:shadow-blue-500/30 transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 text-lg">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    <span>Nova Barbearia</span>
                </button>
            </div>
        </div>

        <div class="mt-12 bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden transition-colors duration-300">
            <div class="p-6 border-b border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">Barbearias Cadastradas</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/80 dark:bg-gray-900/50 text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider font-bold">
                            <th class="p-5">Nome</th>
                            <th class="p-5">Link (Slug)</th>
                            <th class="p-5">Telefone</th>
                            <th class="p-5">Status</th>
                            <th class="p-5 text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700/50">
                        <% if (barbearias.length === 0) { %>
                            <tr>
                                <td colspan="5" class="p-8 text-center text-gray-500 dark:text-gray-400 italic">Nenhuma barbearia cadastrada no momento.</td>
                            </tr>
                        <% } else { %>
                            <% barbearias.forEach(b => { %>
                                <tr class="hover:bg-blue-50/50 dark:hover:bg-gray-700/50 transition-colors group">
                                    <td class="p-5 font-semibold text-gray-900 dark:text-white"><%= b.nome %></td>
                                    <td class="p-5">
                                        <a href="https://solucaosobmedida.com.br/barbearia-app/<%= b.slug %>" target="_blank" class="text-blue-500 hover:text-blue-700 font-medium transition-colors flex items-center space-x-1">
                                            <span><%= b.slug %></span>
                                            <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                        </a>
                                    </td>
                                    <td class="p-5 text-gray-600 dark:text-gray-300 text-sm"><%= b.telefone || 'Não informado' %></td>
                                    <td class="p-5">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold tracking-wide <%= b.status === 'ativo' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400' : 'bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-400' %>">
                                            <%= b.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="p-5 text-center">
                                        <a href="/barbearia-app/superadmin/status/<%= b.id %>/<%= b.status %>" 
                                        class="px-4 py-2 rounded-lg text-white text-xs font-bold shadow-sm transition-all <%= b.status === 'ativo' ? 'bg-amber-500 hover:bg-amber-600 hover:shadow-amber-500/30' : 'bg-emerald-500 hover:bg-emerald-600 hover:shadow-emerald-500/30' %>">
                                            <%= b.status === 'ativo' ? 'Desativar' : 'Ativar' %>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <div id="modalCadastro" class="hidden fixed inset-0 z-50 items-center justify-center p-4 transition-opacity duration-300 opacity-0">
    
    <div class="relative z-10 bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-8 shadow-2xl transform scale-95 transition-transform duration-300 border border-gray-100 dark:border-gray-700">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-extrabold text-gray-900 dark:text-white tracking-tight">Nova Barbearia</h3>
            <button onclick="toggleModal('modalCadastro')" class="text-gray-400 hover:text-gray-600 dark:hover:text-white bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-full p-2 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <form action="/barbearia-app/superadmin/cadastrar" method="POST" class="space-y-5">
            <div>
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Nome da Barbearia</label>
                <input type="text" name="nome" required class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Slug <span class="font-normal text-gray-400">(Link único na URL)</span></label>
                <input type="text" name="slug" placeholder="ex: donjuan-barber" required class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Telefone</label>
                <input type="text" name="telefone" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Status Inicial</label>
                <select name="status" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all appearance-none cursor-pointer">
                    <option value="teste_gratis">Teste Grátis (7 dias)</option>
                    <option value="ativo">Ativo (Pago)</option>
                </select>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
                <button type="button" onclick="toggleModal('modalCadastro')" class="px-5 py-2.5 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl font-semibold transition-colors">Cancelar</button>
                <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-xl font-bold shadow-md hover:shadow-blue-500/30 transition-all">Salvar Sistema</button>
            </div>
        </form>
    </div>

    <div class="absolute inset-0 bg-gray-900/60 glass-effect" onclick="toggleModal('modalCadastro')"></div>
</div>

<script src="/barbearia-app/public/js/dashboard_superAdmin.js"></script>
<script src="/barbearia-app/public/js/theme.js"></script>

</body>
</html>